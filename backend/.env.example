# Sber500 x DISRUPT — OpenAI-compatible proxy (multitool.works)
LLM_API_KEY=
LLM_BASE_URL=https://shared1.multitool.works:4000/v1
LLM_MODEL=gigachat-3-pro
# Hard cap on generated morning messages per day (budget guard)
LLM_DAILY_CAP=300
# ₽ per 1M tokens — used for cost metrics (GigaChat-3-Pro prices)
LLM_PRICE_IN_PER_1M=73.03
LLM_PRICE_OUT_PER_1M=176.39

# PostgreSQL
DATABASE_URL=postgres://companion:password@localhost:5432/companion?sslmode=disable

# App
PORT=8080
ENV=development
# Product time zone: "today", the 04:10 generation and metrics use it
APP_TZ=Europe/Moscow

# Analytics — developer user IDs to exclude from metrics
DEV_USER_IDS=
# Origin allowed to read /api/v1/metrics; * = anyone (aggregate numbers only)
METRICS_ALLOWED_ORIGIN=*

# Bind address; production: 127.0.0.1:8080 (only Caddy talks to the API)
LISTEN_ADDR=

# Prompt admin API — local-only port, disabled unless ADMIN_TOKEN has 32+ chars
ADMIN_ADDR=127.0.0.1:9090
ADMIN_TOKEN=
# Optional Telegram notifications about prompt changes
TG_BOT_TOKEN=
TG_CHAT_ID=
